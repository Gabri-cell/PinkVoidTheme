{
  "manifest_version": 2,
  "version": "1.3",
  "name": "Pink Pixel Lollipop",
  "description": "Dark theme with pink active tab highlight",
  "author": "Gabrielle Andrade",
  "homepage_url": "https://github.com/GabrielleAndrade/PinkVoidTheme",
  "applications": {
    "gecko": {
      "id": "pinkvoidtheme@gabrielleandrade.dev",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": [10, 10, 10],
      "frame_inactive": [8, 8, 8],
      "toolbar": [34, 34, 34],
      "tab_background_inactive": [10, 10, 10],
      "tab_background_inactive_frame_inactive": [8, 8, 8],
      "ntp_background": [22, 22, 22],
      "ntp_text": [219, 92, 133],
      "bookmark_text": [238, 175, 195],
      "tab_text": [219, 92, 133],
      "background_tab_text": [100, 100, 100],
      "toolbar_field": [24, 24, 24],
      "toolbar_field_text": [238, 175, 195],
      "toolbar_button_icon": [219, 92, 133],
      "toolbar_top_separator": [219, 92, 133],
      "toolbar_bottom_separator": [34, 34, 34],
      "tab_stroke": [219, 92, 133],
      "tab_stroke_inactive": [10, 10, 10],
      "thumb_tint": [219, 92, 133],
      "thumb_hover_tint": [232, 125, 161],
      "track_tint": [26, 26, 26],
      "track_hover_tint": [34, 34, 34]
    },
    "tints": {
      "buttons": [0.94, 0.45, 0.65]
    },
    "properties": {
      "ntp_logo_alternate": 1
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["bubble-dark-pink.css"]
    }
  ]
}